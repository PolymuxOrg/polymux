{
  "name": "polymux",
  "version": "0.0.0",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "polymux": "./dist/index.js"
  },
  "files": [
    "dist",
    "schema",
    "LICENSE",
