    "@polymux/adapter-web": "0.0.0",
    "@polymux/core": "0.0.0",
    "@polymux/protocol": "0.0.0",
    "@polymux/runner": "0.0.0",
    "@polymux/test-gates": "0.0.0",
    "commander": "14.0.0",
    "posthog-node": "5.46.0",
    "yaml": "2.9.0"
  }
}
